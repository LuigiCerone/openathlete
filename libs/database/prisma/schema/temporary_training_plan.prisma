// ============================================================================
// Temporary Training Plan Models
// ============================================================================
// Temporary storage for SEO training plans before import into user accounts.
// Plans expire after 7 days and are marked as imported when used.
// ============================================================================

/// Temporary training plan storage.
/// Stores SEO training plan data temporarily before user imports it.
/// Plans expire after 7 days and are marked as imported when used.
model TemporaryTrainingPlan {
  // primary key
  id String @id @default(uuid())

  // fields
  /// JSON structured plan data (TrainingPlan + Cycles + TrainingWeeks + Events)
  planData Json
  /// When the plan was created
  createdAt DateTime @default(now()) @map("created_at")
  /// When the plan expires (7 days after creation)
  expiresAt DateTime @map("expires_at")
  /// When the plan was imported (null if not yet imported)
  importedAt DateTime? @map("imported_at")

  @@index([expiresAt])
  @@map("temporary_training_plan")
}

